#!/usr/bin/env bash
set -euo pipefail

# setup-base: install the openchamber snap and enable user linger.
# Runs as root. Must be idempotent.

echo "[openchamber] setup-base: installing openchamber snap"

# Try installing from the local path (env var) first, then the Snap Store.
if [ -n "${OPENCHAMBER_SNAP_PATH:-}" ] && [ -f "$OPENCHAMBER_SNAP_PATH" ]; then
  echo "[openchamber] Installing from $OPENCHAMBER_SNAP_PATH"
  snap install --dangerous "$OPENCHAMBER_SNAP_PATH"
elif snap list openchamber &>/dev/null; then
  echo "[openchamber] openchamber snap already installed"
else
  echo "[openchamber] Installing openchamber from the Snap Store"
  snap install --edge openchamber
fi

# Enable linger so the user systemd service starts on boot without login.
echo "[openchamber] Enabling linger for workshop user"
loginctl enable-linger workshop

# Make /snap/bin available in interactive shells.
cat > /etc/profile.d/openchamber.sh <<'PROFILE'
export PATH="/snap/bin:$PATH"
PROFILE

# Install the helper that applies memory limits to the OpenCode service.
# systemd does not expand environment variables in MemoryMax=/MemoryHigh=, so
# the helper sources /project/openchamber-env.sh (if present) and applies
# OPENCODE_MEM_MAX / OPENCODE_MEM_HIGH via `systemctl set-property --runtime`.
# Unset values reset the limit to "infinity", so removing a variable takes
# effect on the next restart.
echo "[openchamber] Installing opencode memory limits helper"

mkdir -p /usr/local/lib/openchamber

cat > /usr/local/lib/openchamber/opencode-memory-limits <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="/project/openchamber-env.sh"
UNIT="openchamber-opencode.service"

mem_max=""
mem_high=""
if [ -r "$ENV_FILE" ]; then
  # Source in a subshell so the file cannot alter this script's state.
  { read -r mem_max; read -r mem_high; } < <(
    # shellcheck source=/dev/null
    . "$ENV_FILE" >/dev/null
    printf '%s\n%s\n' "${OPENCODE_MEM_MAX:-}" "${OPENCODE_MEM_HIGH:-}"
  )
fi

mem_max="${mem_max:-infinity}"
mem_high="${mem_high:-infinity}"

echo "[openchamber] Applying MemoryMax=$mem_max MemoryHigh=$mem_high to $UNIT"
exec systemctl --user set-property --runtime "$UNIT" \
  "MemoryMax=$mem_max" "MemoryHigh=$mem_high"
HELPER

chmod 755 /usr/local/lib/openchamber/opencode-memory-limits

# Install OpenCode systemd user unit (global location for all users).
echo "[openchamber] Installing opencode systemd user unit"

mkdir -p /etc/systemd/user

cat > /etc/systemd/user/openchamber-opencode.service <<'UNIT'
[Unit]
Description=OpenCode Agent Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/project
ExecStartPre=-/usr/local/lib/openchamber/opencode-memory-limits
ExecStart=/snap/bin/opencode serve --hostname 127.0.0.1 --port 2018
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT

# Reload, enable, and start the service as the workshop user.
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user daemon-reload
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user enable openchamber-opencode.service
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user start openchamber-opencode.service

echo "[openchamber] openchamber-opencode.service installed and started"

echo "[openchamber] setup-base complete"
