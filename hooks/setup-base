#!/usr/bin/env bash
set -euo pipefail

# setup-base: install the openchamber snap and enable user linger.
# Runs as root. Must be idempotent.

echo "[openchamber-sdk] setup-base: installing openchamber snap"

# Try installing from the local path (env var) first, then the Snap Store.
if [ -n "${OPENCHAMBER_SNAP_PATH:-}" ] && [ -f "$OPENCHAMBER_SNAP_PATH" ]; then
  echo "[openchamber-sdk] Installing from $OPENCHAMBER_SNAP_PATH"
  snap install --dangerous "$OPENCHAMBER_SNAP_PATH"
elif snap list openchamber &>/dev/null; then
  echo "[openchamber-sdk] openchamber snap already installed"
else
  echo "[openchamber-sdk] Installing openchamber from the Snap Store"
  snap install --edge openchamber
fi

# Enable linger so the user systemd service starts on boot without login.
echo "[openchamber-sdk] Enabling linger for workshop user"
loginctl enable-linger workshop

# Make /snap/bin available in interactive shells.
cat > /etc/profile.d/openchamber.sh <<'PROFILE'
export PATH="/snap/bin:$PATH"
PROFILE

# Install OpenCode systemd user unit (global location for all users).
echo "[openchamber-sdk] Installing opencode systemd user unit"

mkdir -p /etc/systemd/user

cat > /etc/systemd/user/openchamber-opencode.service <<'UNIT'
[Unit]
Description=OpenCode Agent Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/project
ExecStart=/snap/bin/opencode serve --hostname 127.0.0.1 --port 2018
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT

# Reload, enable, and start the service as the workshop user.
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user daemon-reload
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user enable openchamber-opencode.service
sudo -u workshop XDG_RUNTIME_DIR=/run/user/1000 systemctl --user start openchamber-opencode.service

echo "[openchamber-sdk] openchamber-opencode.service installed and started"

echo "[openchamber-sdk] setup-base complete"
