#!/usr/bin/env bash
set -euo pipefail

# setup-project: configure OpenChamber as a systemd user service.
# Runs as the workshop user. Must be idempotent.

echo "[openchamber-sdk] setup-project: configuring OpenChamber service"

PASSWORD_FILE="/project/.openchamber-password"

# Generate or reuse the UI password.
if [ -s "$PASSWORD_FILE" ]; then
  echo "[openchamber-sdk] Reusing existing password from $PASSWORD_FILE"
elif [ -f "$PASSWORD_FILE" ]; then
  # File exists but is empty — treat as missing and regenerate.
  echo "[openchamber-sdk] Password file exists but is empty — regenerating"
  openssl rand -hex 16 > "$PASSWORD_FILE"
  chmod 600 "$PASSWORD_FILE"
else
  echo "[openchamber-sdk] Generating new password to $PASSWORD_FILE"
  openssl rand -hex 16 > "$PASSWORD_FILE"
  chmod 600 "$PASSWORD_FILE"
fi

PASSWORD=$(cat "$PASSWORD_FILE")

# Prevent accidental git commit of the password file.
GITIGNORE="/project/.gitignore"
if [ -f "$GITIGNORE" ]; then
  grep -qxF '.openchamber-password' "$GITIGNORE" || echo '.openchamber-password' >> "$GITIGNORE"
else
  echo '.openchamber-password' > "$GITIGNORE"
fi

# Write the systemd user unit directly instead of calling openchamber startup enable.
# This avoids a runtime dependency on the openchamber CLI for service creation and
# gives us full control over the unit file contents.
OPENCODE_PORT="2018"
OPENCHAMBER_PORT="3000"
UNIT_FILE="$HOME/.config/systemd/user/openchamber.service"

echo "[openchamber-sdk] Creating openchamber systemd user unit"
mkdir -p "$(dirname "$UNIT_FILE")"

cat > "$UNIT_FILE" <<SYSTEMD_UNIT
[Unit]
Description=OpenChamber web server
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/home/workshop/.config/openchamber/startup.env
Environment=OPENCODE_SKIP_START=1
Environment=OPENCODE_HOST=127.0.0.1
Environment=OPENCODE_PORT=${OPENCODE_PORT}
ExecStart=/snap/bin/openchamber serve --foreground --port ${OPENCHAMBER_PORT} --lan --ui-password ${PASSWORD}
WorkingDirectory=/project
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
SYSTEMD_UNIT

# Reload systemd and restart the service so the new WorkingDirectory takes effect.
systemctl --user daemon-reload
systemctl --user restart openchamber.service 2>/dev/null || \
  systemctl --user start openchamber.service

# Verify the service is running.
if systemctl --user is-active openchamber.service >/dev/null 2>&1; then
  echo "[openchamber-sdk] openchamber.service is active"
else
  echo "[openchamber-sdk] WARNING: openchamber.service is not active"
fi

echo "[openchamber-sdk] setup-project complete"